# ==============================================================================
# VPS DOCKER STACK - ENVIRONMENT CONFIGURATION (PT ERA DEPO PRIMA)
# ==============================================================================
# File ini digunakan oleh Traefik, Apps, dan Mail Server.
# Hak akses file: chmod 600 .env

# --- 1. DOMAIN & SSL CONFIGURATION ---
DOMAIN_NAME=eradepoprima.com
ACME_EMAIL=admin@eradepoprima.com

# Subdomain Routing
WEB_SUBDOMAIN=www
API_SUBDOMAIN=api
MAIL_SUBDOMAIN=mail

# --- 2. TRAEFIK REVERSE PROXY CONFIGURATION ---
TRAEFIK_DASHBOARD_ENABLE=false
TRAEFIK_DASHBOARD_USERS=admin:$$apr1$$samplehash$$sample

# --- 3. DATABASE CONFIGURATION (POSTGRESQL - 100% INTERNAL ONLY) ---
DB_NAME=eradepoprima_db
DB_USER=edp_admin
# Ganti dengan password kuat acak pilihan Anda saat deployment
DB_PASSWORD=EdpSecureDbPassword_2026!#
DB_HOST=postgres
DB_PORT=5432

# --- 4. CACHE / REDIS CONFIGURATION (100% INTERNAL ONLY) ---
REDIS_PASSWORD=EdpSecureRedisPassword_2026!#
REDIS_HOST=redis
REDIS_PORT=6379

# --- 5. API SERVICE CONFIGURATION ---
NODE_ENV=production
API_PORT=3000
JWT_SECRET=EdpSecureJWTSecretKey_9876543210!#

# --- 6. MAIL SERVER CONFIGURATION (DOCKER-MAILSERVER) ---
MAIL_HOSTNAME=mail.eradepoprima.com
# Fitur Keamanan Email (1 = aktif, 0 = nonaktif)
ENABLE_RSPAMD=1
ENABLE_CLAMAV=1          # Aktif: RAM 4GB sangat aman & mumpuni untuk scan antivirus email
ENABLE_FAIL2BAN=1
ENABLE_POSTGREY=0
ENABLE_OPENDKIM=1

# Postmaster email
POSTMASTER_ADDRESS=postmaster@eradepoprima.com

# --- 7. TIMEZONE ---
TZ=Asia/Jakarta
